# Configuración del Entorno Skyfussion Analytics - Backend
DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

