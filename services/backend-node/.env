NODE_ENV=development
PORT=3000

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_DATABASE=neo4j

# Event System
EVENT_EMITTER_MODE=native

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# RabbitMQ Configuration (Agent Event Bus)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=skyfusion
RABBITMQ_PASS=skyfusion_secure_pass
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=skyfusion.events
RABBITMQ_HEARTBEAT=60
RABBITMQ_RECONNECT_DELAY_MS=5000
RABBITMQ_MAX_RECONNECT_ATTEMPTS=10

# Fallback: File-based event store when RabbitMQ is unavailable
EVENT_STORE_MODE=auto

# Google Earth Engine API
GEE_SERVICE_ACCOUNT_EMAIL=skyfusion-sa@skyfusion.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./config/gee-private-key.json
GEE_PROJECT=skyfusion-analytics

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# Agent Orchestrator
ORCHESTRATOR_DEFAULT_TIMEOUT_MS=300000
ORCHESTRATOR_MAX_RETRIES=3
